# Active chain — 84532 = Base Sepolia (default), 31337 = local anvil.
VITE_CHAIN_ID=84532

# RPC URL for the active chain. Defaults to https://sepolia.base.org for 84532 and
# http://localhost:8545 for 31337 if unset.
VITE_RPC_URL=https://sepolia.base.org

# Contract addresses from `forge script script/DeployTestnet.s.sol` (see the root README's
# "Deploying to Base Sepolia" section). Required for any chain other than 31337 — anvil's
# deterministic defaults only apply locally.
VITE_NOCTUA_ADDRESS=0x0000000000000000000000000000000000000000
VITE_LOAN_ADDRESS=0x0000000000000000000000000000000000000000
VITE_COLLATERAL_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ORACLE_ADDRESS=0x0000000000000000000000000000000000000000
