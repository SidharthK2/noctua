# Absolute public URL of the deployment (e.g. the Railway URL, no trailing slash) — substituted
# into the OG/SEO tags in index.html at build time. Unset → relative /og-image.png paths, which
# most social scrapers ignore; set it for production builds.
VITE_APP_URL=

# Active chain — 8453 = Base mainnet (production), 84532 = Base Sepolia (default),
# 31337 = local anvil.
VITE_CHAIN_ID=84532

# RPC URL for the active chain. Defaults per chain if unset: https://mainnet.base.org (8453),
# https://sepolia.base.org (84532), http://localhost:8545 (31337). Note this URL ships in the
# public frontend bundle — don't put a secret-keyed endpoint here unless it's domain-restricted.
VITE_RPC_URL=https://sepolia.base.org

# Contract addresses. The Noctua address is always required off-anvil. On Base mainnet (8453)
# the token addresses default to the real KRWQ and canonical WETH; on testnets they must be set
# to the mock addresses from `forge script script/DeployTestnet.s.sol` (see the root README).
VITE_NOCTUA_ADDRESS=0x0000000000000000000000000000000000000000
VITE_LOAN_ADDRESS=0x0000000000000000000000000000000000000000
VITE_COLLATERAL_ADDRESS=0x0000000000000000000000000000000000000000
