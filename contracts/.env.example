# Copied by forge automatically when running from the contracts/ directory. Never commit .env.

# Funded deployer key — testnet deploys (script/DeployTestnet.s.sol) or the Base mainnet deploy
# (script/DeployMainnet.s.sol; needs real ETH on Base).
DEPLOYER_PRIVATE_KEY=

# Base mainnet RPC for the `base` rpc alias in foundry.toml (e.g. a keyed Alchemy endpoint).
BASE_RPC_URL=https://mainnet.base.org

# Etherscan v2 API key — one key verifies on all chains (consumed via foundry.toml [etherscan]).
ETHERSCAN_API_KEY=
